<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Клиенты — Чинар' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="style.css" />
  <link rel="stylesheet" href="mobile.css" />
  <script src="script.js" defer></script>
</head>

<body>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">
        <img src="img/logo.png" alt="Чинар">
        Чинар
      </a>
      <nav class="site-nav">
        <a href="/">О компании</a>
        <a href="/services">Услуги</a>
        <a href="/clients">Клиенты</a>
        <a href="/vacancies">Вакансии</a>
        <a href="/contacts">Контакты</a>
      </nav>
      <button class="burger-btn" aria-label="Меню" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <main class="clients-page">

    <section class="clients-hero-section">
      <div class="clients-inner">
        <div class="clients-hero">
          <div class="clients-hero-image">
            <img src="img/clients/Наши клиенты.png" alt="Наши клиенты">
          </div>
          <div class="clients-hero-text">
            <p class="clients-hero-accent">Наши клиенты</p>
            <h1 class="clients-hero-title">
              <span class="text-dark">Нам доверяют</span>
              <span class="text-orange">ведущие<br>компании</span>
              <span class="text-dark">и</span>
              <span class="text-orange">организации<br>России</span>
            </h1>
            <div class="clients-hero-bottom">
              <p class="clients-hero-description">
                Полученные нашим ЧОП отзывы и рекомендации от клиентов являются гарантией
                надежных и долгосрочных отношений
              </p>
              <a href="/services" class="hero-cta">Заказать услугу</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="clients-section">
      <div class="clients-inner">

        <% if (typeof clientsGrouped !== 'undefined' && Object.keys(clientsGrouped).length > 0) { %>
          <% let catIndex = 0; %>
          <% for (const [category, clients] of Object.entries(clientsGrouped)) { %>
            <% catIndex++; %>
            <% const sectionNumber = String(catIndex).padStart(2, '0'); %>
            <div class="clients-category">
              <div class="clients-category-header">
                <h2 class="section-title"><%= category %></h2>
                <div class="section-line"></div>
                <span class="section-number"><%= sectionNumber %></span>
              </div>
              <div class="clients-row">
                <% clients.forEach(client => { %>
                  <% const logoSrc = client.logoPath ? (client.logoPath.startsWith('/') ? client.logoPath : '/' + client.logoPath) : '/img/clients/default.png'; %>
                  <img src="<%= logoSrc %>" alt="<%= client.name %>">
                <% }) %>
              </div>
            </div>
          <% } %>
        <% } else { %>
          <p>Информация о клиентах временно недоступна.</p>
        <% } %>

      </div>
    </section>

  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-col">
        <span>Компания Чинар</span>
        <span>+7 844 260-14-00</span>
        <span>+7 927 514-23-70</span>
        <span>chopohrana@mail.ru</span>
        <span>ИНН: 3447021430</span>
        <span>ОГРН: 1043400515344</span>
        <span>©2004-2026</span>
      </div>

      <div class="footer-col">
        <span>400001, Волгоградская область, город Волгоград, Академическая ул., д. 32, помещ. 3</span>
      </div>

      <div class="footer-col">
        <span>Карта сайта:</span>
        <a href="/">О компании</a>
        <a href="/services">Услуги</a>
        <a href="/clients">Клиенты</a>
        <a href="/vacancies">Вакансии</a>
        <a href="/contacts">Контакты</a>
      </div>

      <div class="footer-col">
        <span>Лицензия</span>
        <span>Л056-00106-34/00030263 от 20.05.2009. Продлена Управлением Федеральной службы войск национальной гвардии Российской Федерации по Волгоградской области</span>
      </div>
    </div>
  </footer>

</body>
</html>